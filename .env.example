# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
#   cp .env.example .env

# The token every request must send as "Authorization: Bearer <key>".
# Make a fresh one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# The language model that repairs and translates the transcript. Needed even
# when the target language is the same as the source: that step also fixes
# what whisper misheard and shares the lines out between cues.
# LLM_PROVIDER is openai (the default) or gemini; only that one needs a key.
#LLM_PROVIDER=openai
OPENAI_API_KEY=
#GEMINI_API_KEY=
# Empty: gpt-4o-mini for openai, gemini-2.5-flash for gemini.
#LLM_MODEL=

# ---------------------------------------------------------------------------
# Everything below has a working default. Set it only to change something.
# ---------------------------------------------------------------------------

# Set to 0 to start with no models loaded. The API answers and every job
# fails at once. Only for working on the HTTP side without a GPU.
#LOAD_MODELS=1

# Set to 0 to skip loading LatentSync. On by default. When off, a job that
# asks for lipsync runs without it, as if the box was not ticked.
#LOAD_LIPSYNC=1

# Screen text that OCR read with a lower score than this is sent to the
# model with a picture of it, so the model reads the words again.
#SCREEN_VISION_BELOW=0.95

# Result files are deleted after a download, or after this many seconds.
#JOB_TTL_SECONDS=3600

# 200 MB and 25 MB. MAX_REQUEST_BYTES caps the whole request and is checked
# before the body is read at all; the other two are checked while saving.
#MAX_VIDEO_BYTES=209715200
#MAX_AUDIO_BYTES=26214400
#MAX_REQUEST_BYTES=236978176

# 512 is the model this was set up for. configs/unet/stage2.yaml is the
# 256 version: faster, and it needs less memory.
#LATENTSYNC_CONFIG=configs/unet/stage2_512.yaml
#LATENTSYNC_CHECKPOINT=checkpoints/latentsync_unet.pt
